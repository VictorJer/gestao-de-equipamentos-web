@using GestaoDeEquipamentosWeb.ConsoleApp.ModuloFabricante

@model List<Fabricante>;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listar";
}

<a class="btn-cad" href="/Fabricante/Cadastrar">Cadastrar Novo</a>

<table class="registros">

    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>

    
    <tbody>
        @foreach (Fabricante f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td>
                    <a href="/Fabricante/Editar/@f.Id">Editar</a>
                    <a href="/Fabricante/Excluir/@f.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
