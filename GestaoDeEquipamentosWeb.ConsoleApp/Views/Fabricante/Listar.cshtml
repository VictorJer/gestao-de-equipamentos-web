@using GestaoDeEquipamentosWeb.ConsoleApp.ModuloFabricante

@model List<Fabricante>;

<h1>Gestão de Equipamentos</h1>

<hr>
<a href="/Fabricante/Listar">Controle de Fabricantes</a> -
<a href="/Equipamentos/Listar">Controle de Equipamentos</a> -
<a href="/Chamados/Listar">Controle de Chamados</a> -
<a href="https://www.academiadoprogramador.net" target="_blank">academia do programador</a>

<hr>

<h2>Listagem de Fabricantes</h2>

<hr>


<table>
    <thead>
        <tr>
            <td>ID</td>
            <td>Nome</td>
            <td>Email</td>
            <td>Telefone</td>
        </tr>
    </thead>

    <a href="/Fabricante/Cadastrar">Cadastrar</a>
    <tbody>
        @foreach (Fabricante f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
            </tr>
        }
    </tbody>
</table>
